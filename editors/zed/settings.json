{
  "lsp": {
    "hmx-ls": {
      "binary": {
        "path": "hmx-lsp",
        "arguments": ["serve"]
      }
    }
  },
  "languages": {
    "XML": {
      "language_servers": ["hmx-ls"]
    },
    "Python": {
      "language_servers": ["pyright", "hmx-ls"]
    },
    "JavaScript": {
      "language_servers": ["vtsls", "hmx-ls"]
    },
    "Vue.js": {
      "language_servers": ["vue-language-server", "hmx-ls"]
    }
  }
}
